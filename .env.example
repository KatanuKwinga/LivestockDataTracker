# Signs login sessions and password-reset links. Must be long, random and secret.
SECRET_KEY=change-this-to-a-long-random-string

# Supabase -> your project -> Connect -> "Session pooler".
# Change "postgresql://" to "postgresql+psycopg2://" and add ?sslmode=require
DATABASE_URL=postgresql+pg8000://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
